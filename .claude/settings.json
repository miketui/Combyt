      "Read(*)",
      "Agent(*)",
      "mcp__github__*"
    ]
  },
  "env": {
    "TAYLKOMB_PROJECT": "Combyt",
    "TAYLKOMB_REV": "D",
    "TAYLKOMB_SOCKET_OD": "4.10",
